# Server-only. Never prefix a secret with NEXT_PUBLIC_.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Local SQLite; for Vercel set a persistent Turso/libSQL database.
DATABASE_URL=file:data/edutest.db
DATABASE_AUTH_TOKEN=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Required to create a teacher account; students do not need an invitation.
TEACHER_INVITE_CODE=
APP_URL=http://127.0.0.1:3000
